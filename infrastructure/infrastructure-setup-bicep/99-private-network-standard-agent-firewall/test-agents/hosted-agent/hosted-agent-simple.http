@token=
@subscriptionid=b045f4eb-724b-4361-80ff-2a0ff999a996
@agent=burnley-shop-assistant
@foundry=publicfoundryaustraliaeast
@project=proj-default
@rg=PublicFoundry2

GET https://{{foundry}}.services.ai.azure.com/api/projects/{{project}}/agents/{{agent}}?api-version=2025-11-15-preview
Content-Type: application/json
Authorization: Bearer {{token}}
Foundry-Features: HostedAgents=V1Preview

###

POST https://{{foundry}}.services.ai.azure.com/api/projects/{{project}}/agents/{{agent}}?api-version=2025-11-15-preview
Content-Type: application/json
Authorization: Bearer {{token}}
Foundry-Features: HostedAgents=V1Preview

{
  "name": "{{agent}}",
  "definition": {
    "kind": "hosted",
    "container_protocol_versions": [
      {
        "protocol": "responses",
        "version": "1.0.0"
      }
    ],
    "cpu": "0.5",
    "memory": "1Gi",
    "image": "mafaacr.azurecr.io/hosted-agent-test:0.1",
    "environment_variables": {
      "AZURE_AI_MODEL_DEPLOYMENT_NAME": "gpt-5.4"
    }
  },
  "description": "A Burnley FC club-shop assistant."
}

### Hit the local responses API!
POST http://localhost:8088/responses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": [
    {
      "role": "user",
      "content": "Tell me an awesome fact about Burnley Football Club (hint use the MCP tools)?"
    }
  ]
}



### Hit the local responses API!
POST http://localhost:8088/responses
Content-Type: application/json
Authorization: Bearer {{token}}

{
  "input": [
    {
      "role": "user",
      "content": "Tell me an awesome fact about Burnley Football Club (hint use the MCP tools)?"
    }
  ]
}
